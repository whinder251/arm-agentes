# Variables de entorno obligatorias para ARM
# Copiar este archivo a .env y reemplazar los placeholders por valores reales antes de ejecutar el proyecto.
# Nunca copies valores reales en este archivo ni los confirmes en Git.

# Clave secreta de Django (obligatoria en C.1b).
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion

# Clave de cifrado Fernet para api_key de Proveedor (RB-013, obligatoria en C.1b).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARM_ENCRYPTION_KEY=tu-clave-fernet-aqui-cambiar-en-produccion

# Clave de autenticación para la API REST (endpoints webhook).
# Ejemplo solo para desarrollo local. En producción usar un token generado y rotado.
ARM_API_KEY=dev-api-key-123

# Modo depuración. Valor seguro por defecto: False.
# Solo desarrollo local: descomentar y usar DEBUG=True explícitamente en .env.
DEBUG=False

# Hosts permitidos por Django (separados por comas).
ALLOWED_HOSTS=localhost,127.0.0.1
